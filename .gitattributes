# Normalize line endings for all text files to LF in the repo.
# Working trees on Windows may still see CRLF, but committed blobs are LF.
* text=auto eol=lf

# Explicitly mark common text formats so editors and CI agree.
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.json   text eol=lf
*.sh     text eol=lf

# Binary assets — never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.svg    text eol=lf
*.ico    binary
*.pdf    binary
